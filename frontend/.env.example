# Copy to `.env.development.local` if you need overrides.

# --- Static demo (Netlify / no backend) ---
# Set at build time so the shop uses bundled data + `public/demo/*` images.
# VITE_STATIC_DEMO=true

# --- Local Vite (`http://localhost:5173`) ---
# Requests use `/api/v1/` and are proxied to Django. Start backend: `python manage.py runserver`
# Optional if Django is not on 127.0.0.1:8000:
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# --- Production build (Vercel / Netlify / etc.) ---
# Set before `vite build`:
# VITE_API_BASE_URL=https://your-backend.example.com/api/v1/

# Optional: skip geolocation → `geocode/reverse` when debugging
# VITE_DISABLE_GEOLOCATION=true
